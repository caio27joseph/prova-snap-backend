{
  "__comment": "T-13 dashboard. Metric names verified against the app's real /metrics output (OTel Prometheus exporter, 0.65b0): http_server_duration_milliseconds (histogram, labels http_target/http_status_code), db_client_connections_usage_connections (SQLAlchemy pool gauge, label state), audit_write_failures_total (custom counter from app/observability.py).",
  "title": "Search API — Observability (T-13)",
  "uid": "search-api",
  "tags": ["search-api", "t-13"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request duration p95 / p99 by route (PARTE3 §5: latency per endpoint)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_target) (rate(http_server_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p95 {{http_target}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, http_target) (rate(http_server_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p99 {{http_target}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by status code",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count[1m]))",
          "legendFormat": "HTTP {{http_status_code}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Audit write failures (forensic trail gaps — must stay 0)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(audit_write_failures_total) or vector(0)",
          "legendFormat": "audit failures (total)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DB connection pool by state (SQLAlchemy)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (db_client_connections_usage_connections)",
          "legendFormat": "{{state}}"
        }
      ]
    }
  ]
}
