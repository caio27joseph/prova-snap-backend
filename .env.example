# All values have dev defaults in app/config.py matching docker-compose.yml —
# this file documents what can be overridden; copy to .env only if you need to.
DATABASE_URL=postgresql+psycopg://prova:prova@localhost:5432/prova

# HS256 secret for the mocked Keycloak JWTs (docs/JWT_STRUCTURE.md).
# Any non-empty string works in dev; never commit a real secret.
JWT_SECRET=dev-secret-change-me
